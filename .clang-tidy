# gd-style Systems Hungarian: type prefix + full domain words; see AGENTS.md.
# clang-tidy checks capitalization and m_; tools/hungarian_prefixes.py checks that
# each prefix matches the declared type.
Checks: '-*,readability-identifier-naming'
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|.*/)(src|tests|benchmarks)/.*'
CheckOptions:
  readability-identifier-naming.IgnoreMainLikeFunctions: false
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.EnumCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypedefCase: CamelCase
  readability-identifier-naming.TemplateParameterCase: UPPER_CASE
  readability-identifier-naming.TypeTemplateParameterCase: UPPER_CASE
  readability-identifier-naming.NamespaceCase: lower_case
  readability-identifier-naming.VariableCase: camelBack
  readability-identifier-naming.VariableIgnoredRegexp: '^[a-z][a-z0-9]*(_[a-z0-9]+)*_$'
  readability-identifier-naming.ParameterCase: camelBack
  readability-identifier-naming.ParameterIgnoredRegexp: '^[a-z][a-z0-9]*(_[a-z0-9]+)*_$'
  readability-identifier-naming.ConstantCase: camelBack
  readability-identifier-naming.ConstantIgnoredRegexp: '^[a-z][a-z0-9]*(_[a-z0-9]+)*_$'
  readability-identifier-naming.MemberPrefix: m_
  readability-identifier-naming.MemberCase: camelBack
