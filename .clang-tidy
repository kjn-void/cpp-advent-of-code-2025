# Simonyi's Apps Hungarian: semantic tags, standard constructions, optional qualifiers.
# See AGENTS.md for the vocabulary and C++20 adaptations. Review still checks meaning.
Checks: '-*,readability-identifier-naming'
WarningsAsErrors: '*'
HeaderFilterRegex: '(^|.*/)(src|tests|benchmarks)/.*'
CheckOptions:
  readability-identifier-naming.IgnoreMainLikeFunctions: false
  readability-identifier-naming.FunctionCase: CamelCase
  readability-identifier-naming.MethodCase: CamelCase
  readability-identifier-naming.ClassCase: CamelCase
  readability-identifier-naming.StructCase: CamelCase
  readability-identifier-naming.TypeAliasCase: CamelCase
  readability-identifier-naming.TypeTemplateParameterCase: CamelCase
  readability-identifier-naming.VariableCase: CamelCase
  readability-identifier-naming.VariablePrefix: val
  readability-identifier-naming.VariableIgnoredRegexp: '^(area|bat|bit|blk|bms|bnk|btn|cbat|cblk|cbtn|ccel|ccir|cclk|ccn|ccoef|ccol|cdig|cel|cf|ch|chc|cictr|cid|cir|citem|cjb|clk|cn|cnt|coef|col|cost|cplc|cpr|cpre|cpt|creg|crol|crw|ctl|cus|cwkr|dcol|delta|dev|did|dig|dist|drg|drw|dsu|dx|dy|err|f|fac|fn|gen|grid|hash|ibat|ibtn|icel|icn|icoef|icol|ictr|id|idig|idy|iitem|ijb|ilen|imch|in|iplc|ipt|irng|ishp|it|item|iter|itl|ius|iwkr|jb|jol|jv|len|mask|mat|mch|mpcolcnt|mpcolf|mpcolrw|mpdevcnt|mpdevrgdev|mpcolbit|mpicelf|mpidfac|mpiitemcnt|mpijbcjb|mpijbijb|mpishpcpre|mpishpiplc|mpishprgmask|mpishprgplc|mpiwkrerr|mpiwkrval|mpjvoptcpr|mpparrgchc|mpvstcnt|off|optcost|optcpr|ori|out|par|path|pch|plc|pmpcolcnt|pmpcolf|pos|pr|prb|pre|pslv|pt|qcel|rc|reg|regy|rgbat|rgbnk|rgbtn|rgcel|rgch|rgcjb|rgcn|rgcnt|rgcoef|rgcol|rgdelta|rgdev|rgdig|rgdy|rgf|rgid|rgjb|rglen|rgmask|rgmch|rgori|rgprb|rgpt|rgreg|rgrng|rgrot|rgseg|rgshp|rgtl|rgus|rgval|rgwkr|rgx|rgxy|rgy|rng|rol|rot|rw|seg|setdev|settxt|setvst|shp|slv|tl|txt|us|val|vst|wkr|x|xy|y|z)([A-Z][A-Za-z0-9]*)?_?$'
  readability-identifier-naming.ParameterCase: CamelCase
  readability-identifier-naming.ParameterPrefix: val
  readability-identifier-naming.ParameterIgnoredRegexp: '^(area|bat|bit|blk|bms|bnk|btn|cbat|cblk|cbtn|ccel|ccir|cclk|ccn|ccoef|ccol|cdig|cel|cf|ch|chc|cictr|cid|cir|citem|cjb|clk|cn|cnt|coef|col|cost|cplc|cpr|cpre|cpt|creg|crol|crw|ctl|cus|cwkr|dcol|delta|dev|did|dig|dist|drg|drw|dsu|dx|dy|err|f|fac|fn|gen|grid|hash|ibat|ibtn|icel|icn|icoef|icol|ictr|id|idig|idy|iitem|ijb|ilen|imch|in|iplc|ipt|irng|ishp|it|item|iter|itl|ius|iwkr|jb|jol|jv|len|mask|mat|mch|mpcolcnt|mpcolf|mpcolrw|mpdevcnt|mpdevrgdev|mpcolbit|mpicelf|mpidfac|mpiitemcnt|mpijbcjb|mpijbijb|mpishpcpre|mpishpiplc|mpishprgmask|mpishprgplc|mpiwkrerr|mpiwkrval|mpjvoptcpr|mpparrgchc|mpvstcnt|off|optcost|optcpr|ori|out|par|path|pch|plc|pmpcolcnt|pmpcolf|pos|pr|prb|pre|pslv|pt|qcel|rc|reg|regy|rgbat|rgbnk|rgbtn|rgcel|rgch|rgcjb|rgcn|rgcnt|rgcoef|rgcol|rgdelta|rgdev|rgdig|rgdy|rgf|rgid|rgjb|rglen|rgmask|rgmch|rgori|rgprb|rgpt|rgreg|rgrng|rgrot|rgseg|rgshp|rgtl|rgus|rgval|rgwkr|rgx|rgxy|rgy|rng|rol|rot|rw|seg|setdev|settxt|setvst|shp|slv|tl|txt|us|val|vst|wkr|x|xy|y|z)([A-Z][A-Za-z0-9]*)?_?$'
  readability-identifier-naming.MemberCase: CamelCase
  readability-identifier-naming.MemberPrefix: val
  readability-identifier-naming.MemberIgnoredRegexp: '^(area|bat|bit|blk|bms|bnk|btn|cbat|cblk|cbtn|ccel|ccir|cclk|ccn|ccoef|ccol|cdig|cel|cf|ch|chc|cictr|cid|cir|citem|cjb|clk|cn|cnt|coef|col|cost|cplc|cpr|cpre|cpt|creg|crol|crw|ctl|cus|cwkr|dcol|delta|dev|did|dig|dist|drg|drw|dsu|dx|dy|err|f|fac|fn|gen|grid|hash|ibat|ibtn|icel|icn|icoef|icol|ictr|id|idig|idy|iitem|ijb|ilen|imch|in|iplc|ipt|irng|ishp|it|item|iter|itl|ius|iwkr|jb|jol|jv|len|mask|mat|mch|mpcolcnt|mpcolf|mpcolrw|mpdevcnt|mpdevrgdev|mpcolbit|mpicelf|mpidfac|mpiitemcnt|mpijbcjb|mpijbijb|mpishpcpre|mpishpiplc|mpishprgmask|mpishprgplc|mpiwkrerr|mpiwkrval|mpjvoptcpr|mpparrgchc|mpvstcnt|off|optcost|optcpr|ori|out|par|path|pch|plc|pmpcolcnt|pmpcolf|pos|pr|prb|pre|pslv|pt|qcel|rc|reg|regy|rgbat|rgbnk|rgbtn|rgcel|rgch|rgcjb|rgcn|rgcnt|rgcoef|rgcol|rgdelta|rgdev|rgdig|rgdy|rgf|rgid|rgjb|rglen|rgmask|rgmch|rgori|rgprb|rgpt|rgreg|rgrng|rgrot|rgseg|rgshp|rgtl|rgus|rgval|rgwkr|rgx|rgxy|rgy|rng|rol|rot|rw|seg|setdev|settxt|setvst|shp|slv|tl|txt|us|val|vst|wkr|x|xy|y|z)([A-Z][A-Za-z0-9]*)?_?$'
  readability-identifier-naming.ConstantCase: CamelCase
  readability-identifier-naming.ConstantPrefix: val
  readability-identifier-naming.ConstantIgnoredRegexp: '^(area|bat|bit|blk|bms|bnk|btn|cbat|cblk|cbtn|ccel|ccir|cclk|ccn|ccoef|ccol|cdig|cel|cf|ch|chc|cictr|cid|cir|citem|cjb|clk|cn|cnt|coef|col|cost|cplc|cpr|cpre|cpt|creg|crol|crw|ctl|cus|cwkr|dcol|delta|dev|did|dig|dist|drg|drw|dsu|dx|dy|err|f|fac|fn|gen|grid|hash|ibat|ibtn|icel|icn|icoef|icol|ictr|id|idig|idy|iitem|ijb|ilen|imch|in|iplc|ipt|irng|ishp|it|item|iter|itl|ius|iwkr|jb|jol|jv|len|mask|mat|mch|mpcolcnt|mpcolf|mpcolrw|mpdevcnt|mpdevrgdev|mpcolbit|mpicelf|mpidfac|mpiitemcnt|mpijbcjb|mpijbijb|mpishpcpre|mpishpiplc|mpishprgmask|mpishprgplc|mpiwkrerr|mpiwkrval|mpjvoptcpr|mpparrgchc|mpvstcnt|off|optcost|optcpr|ori|out|par|path|pch|plc|pmpcolcnt|pmpcolf|pos|pr|prb|pre|pslv|pt|qcel|rc|reg|regy|rgbat|rgbnk|rgbtn|rgcel|rgch|rgcjb|rgcn|rgcnt|rgcoef|rgcol|rgdelta|rgdev|rgdig|rgdy|rgf|rgid|rgjb|rglen|rgmask|rgmch|rgori|rgprb|rgpt|rgreg|rgrng|rgrot|rgseg|rgshp|rgtl|rgus|rgval|rgwkr|rgx|rgxy|rgy|rng|rol|rot|rw|seg|setdev|settxt|setvst|shp|slv|tl|txt|us|val|vst|wkr|x|xy|y|z)([A-Z][A-Za-z0-9]*)?_?$'
